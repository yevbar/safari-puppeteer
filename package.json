{
  "name": "safari-puppeteer",
  "version": "0.1.0",
  "description": "Control local Safari with the Puppeteer API, backed by safaridriver (W3C WebDriver) and AppleScript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "safari-puppeteer": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Yev Barkalov <yevbar1729@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/yevbar/safari-puppeteer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yevbar/safari-puppeteer.git"
  },
  "bugs": {
    "url": "https://github.com/yevbar/safari-puppeteer/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/fix-dts-extensions.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "doctor": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli/index.ts doctor",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning test/unit.test.ts test/mcp.test.ts",
    "test:mcp": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning test/mcp.test.ts",
    "test:integration": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning test/integration.test.ts",
    "test:mcp:integration": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning test/mcp-integration.test.ts",
    "test:applescript": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning test/applescript.test.ts",
    "test:all": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning test/*.test.ts",
    "test:package": "node scripts/verify-package.mjs",
    "example": "node --experimental-strip-types --disable-warning=ExperimentalWarning examples/screenshot.ts",
    "prepublishOnly": "npm run build && npm test && npm run test:package"
  },
  "keywords": [
    "safari",
    "puppeteer",
    "safaridriver",
    "webdriver",
    "mcp",
    "model-context-protocol",
    "applescript",
    "automation",
    "browser",
    "headful",
    "macos",
    "webkit",
    "scraping",
    "testing"
  ],
  "dependencies": {
    "@types/node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
